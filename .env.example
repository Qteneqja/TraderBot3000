APP_NAME=AegisTrade AI
APP_ENV=development
DATABASE_URL=postgresql+psycopg://aegis:aegis_local@db:5432/aegis
POSTGRES_PASSWORD=aegis_local
TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
DEMO_MODE=true
# Explicit paper simulation assumptions, not provider fee schedules.
PAPER_FEE_RATE=0
PAPER_SLIPPAGE_TICKS=1
PAPER_FINANCING_PER_UNIT_PER_BAR=0
ADMIN_TOKEN=
OANDA_API_KEY= 
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
# Optional commentary only; cannot authorize trades or supply training labels.
ENABLE_LLM_NARRATIVES=false
LLM_MAX_CALLS_PER_DAY=4
LLM_MIN_INTERVAL_SECONDS=60
DEEPSEEK_API_KEY= 
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN= 
TELEGRAM_CHAT_ID=
RISK_PER_TRADE=0.005 
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.05
MAX_OPEN_POSITIONS=3
INITIAL_PROBABILITY_THRESHOLD=0.80
MIN_RISK_REWARD=2
